    sh_test(
        name = t,
        srcs = ["bazel-test-wrapper.sh"],
        args = ["$(location {}.sh)".format(t)],
        data = ["{}.sh".format(t)] + COMMON_TEST_DATA + TEST_DATA_BY_TEST.get(t, []),
    )
    # Match the shell-test discovery in t/Makefile, including fork-specific tests.
    for t in [
        script[:-3]
        for script in glob(["t*-*.sh"])
        if len(script) > 6 and script[1:5].isdigit() and script[5] == "-"
    ]
]
